# tmux config. Ported from bootstrap.sh:805-856 (Phase 7).
# Only applied for standard/full scope — see .chezmoiignore. TPM, tmux-sensible,
# and Catppuccin are installed by run_onchange_after_30-install-tpm.sh.tmpl.

# Colours / mouse
set-option -sa terminal-overrides ",xterm*:Tc"
set -g mouse on

# Index from 1, renumber on close
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on

# Split in current working directory
bind '"' split-window -v -c "#{pane_current_path}"
bind %  split-window -h -c "#{pane_current_path}"

# Mouse-wheel: behave like a normal terminal (scrollback in shells, arrows in pagers)
bind -T root WheelUpPane \
  if-shell -F -t = '#{?mouse_any_flag,1,#{pane_in_mode}}' \
    'send -M' \
    'if-shell -F -t = "#{alternate_on}" "send -N 3 Up" "copy-mode -e"'
bind -T root WheelDownPane \
  if-shell -F -t = '#{?mouse_any_flag,1,#{pane_in_mode}}' \
    'send -M' \
    'if-shell -F -t = "#{alternate_on}" "send -N 3 Down" "send -M"'

# Plugins ( $HOME, not ~, so the path resolves in set-environment )
set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.config/tmux/plugins"
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'

# Catppuccin v2.3.0. Unlike tmux-sensible above, it is NOT a TPM plugin — it's
# cloned + pinned to tag v2.3.0 by run_onchange_after_30-install-tpm.sh.tmpl and
# sourced manually below. Why: the status-right entries reference
# @catppuccin_status_* format vars that only exist *after* the plugin is sourced,
# but TPM sources its plugins on the very last line (run .../tpm), which would be
# too late. So we load Catppuccin here, before defining status-right.
# (v2.x is a breaking rewrite of the old v0.3.0 @catppuccin_* API — see #487.)
set -g @catppuccin_flavor 'mocha'                  # mocha, macchiato, frappe, latte
set -g @catppuccin_window_status_style 'rounded'   # replaces the old *_separator opts
set -g @catppuccin_window_number_position 'right'
set -g @catppuccin_window_flags 'icon'             # none | icon | text
set -g @catppuccin_window_text ' #W'               # window name (was *_default_text)
set -g @catppuccin_window_current_text ' #W'
set -g @catppuccin_directory_text '#{pane_current_path}'  # full path, not basename

# Load Catppuccin (defines the @catppuccin_status_* vars used just below)
run '~/.config/tmux/plugins/catppuccin/tmux/catppuccin.tmux'

# Right side: current directory + session. In v2 this is explicit status-right
# (the old @catppuccin_status_modules_right was removed).
set -g status-right '#{E:@catppuccin_status_directory}'
set -ag status-right '#{E:@catppuccin_status_session}'

# TPM last — installs/loads tmux-sensible.
run '~/.config/tmux/plugins/tpm/tpm'

# Sunucuyu cron baslatirsa SHELL=/bin/sh kaliyor; pencereler daima zsh acsin (2026-08-28)
set -g default-shell {{ lookPath "zsh" }}

# cmux ssh (cmux 0.65+): a server started inside a `cmux ssh` pane inherits that pane's
# CMUX_TUI_* vars, so agents in every later window would report to that one pane forever.
# Without them cmux's hook helper routes each event to the cmux pane that has the
# session attached at that moment (measured on scraper 2026-10-09).
set-environment -gu CMUX_TUI_HOOK
set-environment -gu CMUX_TUI_SOCKET
set-environment -gu CMUX_TUI_TERMINAL_ID
set-environment -gu CMUX_TUI_SESSION_ID
set-environment -gu CMUX_MUX_SOCKET
