{{- /*
  ~/.config/zsh/.zshrc — a chezmoi TEMPLATE.

  ★ ORDERING IS LOAD-BEARING. This file preserves the exact order bootstrap.sh
    fought for (see bootstrap.sh:735-786 / MIGRATION-PLAN.md §7). Do not reorder:
      1. tmux auto-launch   — MUST be above the p10k instant-prompt block
      2. p10k instant prompt, then Oh My Zsh + plugins + theme
      3. modular configs loaded with exports FIRST (puts ~/.local/bin on PATH)
      4. zoxide init AFTER exports.zsh (so 'z' actually finds the binary)
      5. zsh-syntax-highlighting sourced DEAD LAST (it only colours widgets
         defined before it)

  cmux relay (2026-09-02): a cmux relay shell starts with ZDOTDIR pointing at the
  relay directory and CMUX_REAL_ZDOTDIR at the real one, so every file load goes
  through ZSHCFG (identical to ZDOTDIR in a normal shell), the tmux auto-attach
  skips relay shells, and the p10k wizard is disabled so an ephemeral shell never
  runs it. This block was hand-added on general-lxc and phora-lxc first; a converge
  from a source without it silently reverted it (infra backlog #58).

  The {{ if ne .scope "minimal" }} block below replaces bootstrap.sh's two code
  paths (the build_zshrc() minimal/standard split) with one templated file.
  On minimal: no tmux launch, no Oh My Zsh/p10k — just the modular configs,
  zoxide, and the syntax-highlighting guard (its file simply won't exist).

  The 'lean' scope (lightweight Alpine boxes) sits between minimal and standard:
  NO Oh My Zsh / p10k / tmux, but it DOES source four small plugins directly
  (autosuggestions, fzf-tab, interactive-cd, syntax-highlighting) — installed by
  run_onchange_after_25-install-lean-plugins.sh.tmpl into $XDG_DATA_HOME/zsh/plugins.
  Per fzf-tab's docs the order is load-bearing: compinit, then fzf-tab, then the
  widget-wrapping plugins, with syntax-highlighting DEAD LAST (end of file).
*/ -}}
# cmux relay shell'inde $ZDOTDIR relay dizinini gösterir; asıl zsh config'i
# gerçek dizinde durur. Dosya yüklemeleri bunu kullansın (normal shell'de fark yok).
ZSHCFG="${CMUX_REAL_ZDOTDIR:-$ZDOTDIR}"
{{ if and (ne .scope "minimal") (ne .scope "lean") -}}
# Efemer bir shell'de p10k sihirbazı açılıp emeğini çöpe atmasın:
POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
# --- Auto-launch tmux on SSH (MUST stay above the p10k instant-prompt block) ---
# Bypass once with:  ssh -t user@host "SKIP_TMUX=1 zsh -l"
if [[ -z "$TMUX" ]] && [[ -n "$SSH_CONNECTION" ]] && [[ -t 0 ]] && [[ -z "$SKIP_TMUX" ]] \
   && [[ "$ZDOTDIR" != */.cmux/relay/* ]] ; then
  if command -v tmux &>/dev/null; then
    exec tmux new-session -A -s main      # detaching (C-b d) closes the SSH session
  else
    echo "WARNING: tmux not found; falling back to zsh."
  fi
fi

# p10k instant prompt (keep near the top, but below the tmux block above)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Load exports.zsh BEFORE Oh My Zsh sources the zsh-ai plugin below. zsh-ai reads
# its provider / URL / model / trigger / reasoning-effort AND the API key at plugin
# *load* time, and only binds its Enter-key trigger widget if that config validates.
# Sourced later (in the shared modular loop) the provider was still unset → defaulted
# to anthropic → no key → validation failed → the ",," trigger was never wired up.
# (exports.zsh self-guards, so the loader below re-sourcing it is a harmless no-op.)
[ -f "$ZSHCFG/exports.zsh" ] && source "$ZSHCFG/exports.zsh"

export ZSH="$HOME/.local/share/omz"
ZSH_THEME="powerlevel10k/powerlevel10k"

# NOTE: zsh-syntax-highlighting is intentionally NOT in this array — it must be
# sourced LAST (see end of file), after every other widget is defined.
plugins=(git zsh-autosuggestions you-should-use zsh-interactive-cd zsh-ai)

source "$ZSH/oh-my-zsh.sh"
[[ ! -f "$ZSHCFG/.p10k.zsh" ]] || source "$ZSHCFG/.p10k.zsh"

{{ end -}}
{{ if eq .scope "lean" -}}
# --- lean scope: comfy zsh WITHOUT Oh My Zsh -------------------------------
# Four KB-sized plugins sourced directly (no omz framework / p10k / tmux). The
# completion system MUST be initialised before fzf-tab, and fzf-tab MUST load
# before the widget-wrapping plugins (autosuggestions) — that's fzf-tab's
# documented ordering. zsh-syntax-highlighting is sourced LAST, at end of file.
_lean_plugins="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

# Initialise completion (omz would normally do this for us). -d points the dump
# at the cache dir .zshenv already created. The (#qN.mh+24) glob makes the
# security check run at most once a day instead of on every shell.
autoload -Uz compinit
if [[ -n ${ZSH_CACHE_DIR}/zcompdump(#qN.mh+24) ]]; then
  compinit -d "${ZSH_CACHE_DIR:-$HOME/.cache/zsh}/zcompdump"
else
  compinit -C -d "${ZSH_CACHE_DIR:-$HOME/.cache/zsh}/zcompdump"
fi

# fzf-tab BEFORE autosuggestions (it must wrap completion before they wrap widgets)
[ -f "$_lean_plugins/fzf-tab/fzf-tab.plugin.zsh" ] && source "$_lean_plugins/fzf-tab/fzf-tab.plugin.zsh"
[ -f "$_lean_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && source "$_lean_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -f "$_lean_plugins/zsh-interactive-cd/zsh-interactive-cd.plugin.zsh" ] && source "$_lean_plugins/zsh-interactive-cd/zsh-interactive-cd.plugin.zsh"

{{ end -}}
# Load modular configs (exports first so PATH is ready for the rest)
for f in exports aliases functions fzf; do
  [ -f "$ZSHCFG/$f.zsh" ] && source "$ZSHCFG/$f.zsh"
done

# zoxide AFTER exports.zsh — that's what puts ~/.local/bin (where zoxide and uv
# install) on PATH. Running it earlier meant 'command -v zoxide' failed and the
# 'z' function was never defined.
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# MUST be last: syntax highlighting only colours widgets defined before it.
# lean keeps its plugins under $XDG_DATA_HOME/zsh/plugins; standard/full under omz.
{{ if eq .scope "lean" -}}
_zsh_sh="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
{{ else -}}
_zsh_sh="$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
{{ end -}}
[ -f "$_zsh_sh" ] && source "$_zsh_sh"
